# Copia este archivo a .env y ajusta valores.
# Obligatorias para los daemons:
DAEMON_API_KEY=tu-clave-secreta
BASE_URL=http://gpp_cargo.test

# Timeout HTTP del cliente Axios (ms)
DAEMON_HTTP_TIMEOUT_MS=90000

# Generar guias
GENERATE_POLL_INTERVAL_MS=60000
GENERATE_BATCH_SIZE=30
GENERATE_MIN_AGE_HOURS=2
GENERATE_MANIFEST_ID=

# Emitir guias
EMIT_POLL_INTERVAL_MS=60000
EMIT_POLL_INTERVAL_SEND_SUNAT=2000
EMIT_BATCH_SIZE=50
# EMIT_MAX_CONCURRENCY=1

# Consultar guias
CONSULT_POLL_INTERVAL_MS=20000