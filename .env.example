# Copia este archivo a .env y ajusta valores.
# Obligatorias para los daemons:
DAEMON_API_KEY=tu-clave-secreta
BASE_URL=http://gpp_cargo.test

# Opcionales — emit (src/daemon.js)
# POLL_INTERVAL_MS=5000
# BATCH_SIZE=10
# MAX_CONCURRENCY=1

# Opcionales — generate (src/daemon-generate.js)
# GENERATE_POLL_INTERVAL_MS=10000
# GENERATE_BATCH_SIZE=25
# GENERATE_MIN_AGE_HOURS=2
# GENERATE_MANIFEST_ID=

# Opcionales — consult (src/daemon-consult.js)
# (reutiliza POLL_INTERVAL_MS y BATCH_SIZE si no defines otros)
